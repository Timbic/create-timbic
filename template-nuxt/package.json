{
	"name": "starter-nuxt",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"fmt": "prettier --cache --write .",
		"fmt:chk": "prettier --check .",
		"lint": "eslint --cache",
		"lint:fix": "eslint --cache --fix",
		"typecheck": "nuxt typecheck",
		"prepare": "husky"
	},
	"dependencies": {
		"@nuxt/content": "^3.16.0",
		"@nuxt/fonts": "^0.14.0",
		"@nuxt/icon": "^2.5.1",
		"@nuxt/image": "^2.0.0",
		"@nuxtjs/seo": "^5.0.0",
		"better-sqlite3": "13.0.3",
		"nuxt": "^4.5.2",
		"reka-ui": "^2.10.4",
		"vue": "^3.5.42",
		"vue-router": "^5.3.0",
		"vue-tsc": "^3.3.11"
	},
	"devDependencies": {
		"@nuxt/eslint": "^1.17.0",
		"@timbic/prettier-config": "1.1.4",
		"eslint": "10.9.1",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"prettier": "3.9.6",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*/**/*.{js,ts,vue,css,md,json}": [
			"pnpm fmt",
			"pnpm lint:fix"
		]
	},
	"packageManager": "pnpm@11.24.0"
}
