{
	"name": "create-timbic",
	"type": "module",
	"version": "1.0.1",
	"description": "Timbic's scaffolder cli",
	"author": "Timur Bikmuhametov <tim.bic22@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Timbic/create-timbic.git"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"bin": {
		"create-timbic": "index.js"
	},
	"files": [
		"dist",
		"template-*",
		"index.js"
	],
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"execute": "node index.js",
		"fmt": "prettier --cache --write . --config prettier.config.ts",
		"fmt:chk": "prettier --check . --config prettier.config.ts",
		"lint": "eslint --cache --config eslint.config.ts",
		"lint:fix": "eslint --cache --fix --config eslint.config.ts",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"prepare": "husky"
	},
	"devDependencies": {
		"@clack/prompts": "1.7.0",
		"@timbic/eslint-config": "1.2.0",
		"@timbic/prettier-config": "1.1.4",
		"@types/cross-spawn": "6.0.6",
		"@types/node": "26.4.1",
		"bumpp": "12.2.2",
		"cross-spawn": "7.0.6",
		"eslint": "10.9.1",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"mri": "1.2.0",
		"prettier": "3.9.6",
		"tsdown": "0.22.14",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*/**/*.{js,ts,md,json}": [
			"pnpm fmt",
			"pnpm lint:fix"
		]
	},
	"packageManager": "pnpm@11.24.0"
}
